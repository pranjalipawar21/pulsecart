# PulseCart Server Configuration
# Rename this to .env and fill in your credentials

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=pulsecart

# Security
# Change this to a long random string in production
JWT_SECRET=pulsecart_super_secret_jwt_key_2024

# Server
PORT=5001

# AI Features (Google Gemini)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
